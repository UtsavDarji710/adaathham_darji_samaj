# ==============================================================================
# શ્રી અડાઆઠમ દરજી સેવા સમિતિ (Adaatham Darji Seva Samiti, Modasa)
# Environment Variables Configuration Template
# Copy this file to .env.local for local development or set in Vercel project settings
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. SMTP / NODEMAILER EMAIL DELIVERY (Requirement 14.5)
# Used for sending 6-digit verification OTPs and transactional notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adaadhamsamaj.modasa@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM_EMAIL=adaadhamsamaj.modasa@gmail.com
SMTP_FROM_NAME="શ્રી અડાઆઠમ દરજી સેવા સમિતિ, મોડાસા"

# Note: In local development, if SMTP variables are left blank, the system automatically
# logs OTPs to the server console and provides an on-screen preview pill for easy testing.

# 3. SUPABASE POSTGRESQL & STORAGE CONFIGURATION (Requirement 15)
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 4. STORAGE BUCKET CONFIGURATION
# Configured in Supabase Storage with public and private access policies
NEXT_PUBLIC_BUCKET_MEMBERS=member-photos
NEXT_PUBLIC_BUCKET_BUSINESSES=business-photos
NEXT_PUBLIC_BUCKET_ADS=advertisement-banners
NEXT_PUBLIC_BUCKET_DONORS=donor-photos
NEXT_PUBLIC_BUCKET_PROOFS=payment-proofs
NEXT_PUBLIC_BUCKET_ASSETS=samiti-assets

